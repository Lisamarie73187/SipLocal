{
  "name": "siplocal",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./app/*"
  },
  "scripts": {
    "dev": "vite dev --port 3002",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "security:audit": "node scripts/security-audit.mjs",
    "bug:catch": "node scripts/bug-catcher.mjs",
    "structure:check": "node scripts/code-structure.mjs",
    "db:link": "supabase link",
    "db:types": "supabase gen types typescript --linked 2>/dev/null > app/types/supabase.ts",
    "db:push": "supabase db push --linked --yes",
    "db:reset": "supabase db reset",
    "db:unpublish-low-confidence": "node --env-file=.env.local scripts/unpublish-low-confidence-venues.mjs",
    "db:unpublish-low-confidence:execute": "node --env-file=.env.local scripts/unpublish-low-confidence-venues.mjs --execute"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "mapbox-gl": "^3.24.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
