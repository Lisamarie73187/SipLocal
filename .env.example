# Supabase — server-side (loaders, server functions, service role)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase — client-side (Vite exposes only VITE_* prefixed vars to the browser)
# Set to the same values as SUPABASE_URL and SUPABASE_ANON_KEY above
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Mapbox — public token (required for map landing page)
# In Mapbox dashboard → token URL restrictions (NOT a trailing /*). Use e.g.:
#   http://localhost:*     (any dev port)
#   localhost:3002         (single port)
VITE_MAPBOX_TOKEN=your-mapbox-public-token

# ---------------------------------------------------------------------------
# AI scrape pipeline (server-only — never prefix with VITE_)
# ---------------------------------------------------------------------------

# Google Places API (Nearby Search for venues in a city)
GOOGLE_PLACES_API_KEY=

# Anthropic — happy hour extraction (Haiku recommended for cost)
ANTHROPIC_API_KEY=
ANTHROPIC_HAPPY_HOUR_MODEL=claude-haiku-4-5-20251001

# Yelp Fusion — ratings, photos, cross-reference
YELP_API_KEY=

# Max new venues processed per scrape job
SCRAPE_MAX_VENUES_PER_JOB=25

# Freshness window before re-scraping the same city (days)
SCRAPE_COVERAGE_DAYS=7
